{
  "name": "ytmp3-js",
  "version": "5.0.0-dev",
  "title": "YTMP3",
  "description": "A CLI-based application build on JavaScript offers an easy and uncomplicated method for downloading YouTube audio",
  "main": "index.js",
  "bin": {
    "ytmp3": "./bin/cli.mjs"
  },
  "files": [
    "build/",
    "bin/*",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./build/api/main.d.ts",
      "import": "./build/api/main.js",
      "require": "./build/api/main.js",
      "default": "./build/api/main.js"
    },
    "./helpers": {
      "types": "./build/api/helpers.d.ts",
      "import": "./build/api/helpers.js",
      "require": "./build/api/helpers.js",
      "default": "./build/api/helpers.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "docs": "jsdoc -c jsdoc.config.js",
    "lint": "npm run lint:prod && npm run lint:test",
    "lint:prod": "eslint . --config eslint.config.mjs",
    "lint:test": "eslint . --config eslint.config.test.mjs",
    "test": "npm run test:unit && npm run test:irl",
    "test:no-dltest": "npm run test:unit && npm run test:irl:no-dltest",
    "test:nyan": "mocha --recursive --reporter nyan",
    "test:unit": "mocha test/unittest",
    "test:nyan:unit": "mocha test/unittest --reporter nyan",
    "test:irl": "mocha test/irl.test.mjs",
    "test:irl:no-dltest": "mocha test/irl.test.mjs -g '\\[CONVERT\\]'",
    "coverage": "nyc npm test",
    "coverage:no-dltest": "nyc npm run test:no-dltest",
    "build": "tspc",
    "prebuild": "npm run build:options && npm run build:setup",
    "build:setup": "node scripts/build-setups.mjs",
    "build:options": "node scripts/build-index-options.mjs",
    "prepack": "npm run build"
  },
  "author": "Ryuu Mitsuki <dhefam31@gmail.com> (https://github.com/mitsuki31)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mitsuki31/ytmp3-js.git"
  },
  "homepage": "https://mitsuki31.github.io/ytmp3-js",
  "bugs": {
    "url": "https://github.com/mitsuki31/ytmp3-js/issues"
  },
  "funding": {
    "type": "individual",
    "url": "https://ko-fi.com/dhefam31"
  },
  "engines": {
    "node": ">=16.20.2"
  },
  "dependencies": {
    "@mitsuki31/temppath": "^0.5.0",
    "argparse": "^2.0.1",
    "cli-progress": "^3.12.0",
    "fluent-ffmpeg": "^2.1.3",
    "lsfnd": "^1.1.0",
    "which": "^5.0.0",
    "yargs": "^18.0.0",
    "youtubei.js": "^15.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@tsconfig/node16": "^16.1.4",
    "@types/cli-progress": "^3.11.6",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.15.30",
    "@types/which": "^3.0.4",
    "@types/yargs": "^17.0.33",
    "@typescript-eslint/eslint-plugin": "^8.34.0",
    "eslint": "^9.28.0",
    "eslint-plugin-mocha": "^10.5.0",
    "jsdoc": "^4.0.3",
    "mocha": "^10.7.0",
    "nyc": "^17.0.0",
    "ts-patch": "^3.3.0",
    "tsc-alias": "^1.8.16",
    "ttypescript": "^1.5.15",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0",
    "typescript-transform-paths": "^3.5.5"
  },
  "keywords": [
    "javascript",
    "nodejs",
    "library",
    "ytdl",
    "youtube",
    "youtubedl",
    "ytmp3"
  ]
}
